{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bedashing network metrics v1",
  "type": "object",
  "required": ["model_id", "input_snapshot_id", "source_ids", "primary_radius_km", "radius_bands_km", "distance_method", "overlap_method", "interpretation", "assumptions", "branch_metrics", "pairwise_overlaps"],
  "properties": {
    "model_id": {"const": "bedashing-network-geometry-v1"},
    "input_snapshot_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primary_radius_km": {"type": "number", "exclusiveMinimum": 0},
    "radius_bands_km": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
    "distance_method": {"const": "haversine"},
    "overlap_method": {"const": "analytic_equal_radius_circle_intersection"},
    "interpretation": {"type": "string"},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "branch_metrics": {"type": "array"},
    "pairwise_overlaps": {"type": "array"}
  },
  "additionalProperties": false
}
