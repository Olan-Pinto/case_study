{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bedashing branch record v1",
  "type": "object",
  "required": ["branch_id", "name", "emirate", "community", "address", "status", "latitude", "longitude", "coordinate_confidence", "source_ids", "source_urls", "validation_needed"],
  "properties": {
    "branch_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "emirate": {"enum": ["Abu Dhabi", "Dubai", "Ras Al Khaimah", "Sharjah", "Ajman", "Fujairah", "Umm Al Quwain"]},
    "community": {"type": "string", "minLength": 1},
    "address": {"type": "string", "minLength": 1},
    "status": {"enum": ["observed_currently_listed", "candidate_needs_official_validation", "confirmed_closed", "user_confirmed_permanently_closed"]},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "coordinate_confidence": {"enum": ["none", "secondary_map_coordinate", "user_validated_map_coordinate", "open_geospatial_point", "official_address_geocoded", "official_coordinate"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "validation_needed": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
