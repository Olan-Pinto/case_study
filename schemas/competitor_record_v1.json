{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor record v1",
  "type": "object",
  "required": ["competitor_id", "brand", "name", "taxonomy_class", "emirate", "community", "address", "latitude", "longitude", "coordinate_confidence", "status", "source_ids", "source_urls", "limitations"],
  "properties": {
    "competitor_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "brand": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "taxonomy_class": {"enum": ["direct_premium_full_service", "near_direct_premium_beauty", "local_full_service", "specialist_adjacent", "low_relevance"]},
    "emirate": {"enum": ["Abu Dhabi", "Dubai", "Ras Al Khaimah", "Sharjah", "Ajman", "Fujairah", "Umm Al Quwain"]},
    "community": {"type": "string", "minLength": 1},
    "address": {"type": "string", "minLength": 1},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "coordinate_confidence": {"enum": ["none", "venue_level_proxy", "user_validated_map_coordinate", "official_coordinate"]},
    "status": {"enum": ["officially_listed", "user_verified_currently_listed", "user_confirmed_permanently_closed"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
