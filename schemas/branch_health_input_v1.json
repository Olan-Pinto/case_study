{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branch health input v1",
  "type": "object",
  "required": ["branch_id", "format_archetype", "format_archetype_source_ids", "public_reputation", "source_ids"],
  "properties": {
    "branch_id": {"type": "string", "minLength": 1},
    "format_archetype": {"type": ["string", "null"]},
    "format_archetype_source_ids": {"type": "array", "items": {"type": "string"}},
    "public_reputation": {
      "type": ["object", "null"],
      "required": ["rating_value", "rating_count", "observed_at", "source_id", "source_url"],
      "properties": {
        "rating_value": {"type": "number", "minimum": 0, "maximum": 5},
        "rating_count": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "string", "format": "date"},
        "source_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
